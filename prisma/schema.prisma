datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String          @id // Discord User ID
  username      String
  locale        String          @default("id")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  favorites     Favorite[]
  watchlists    Watchlist[]
  searchHistory SearchHistory[]
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  movieId    String
  title      String
  posterPath String?
  year       Int?
  rating     Float?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@index([userId])
}

model Watchlist {
  id         String   @id @default(cuid())
  userId     String
  movieId    String
  title      String
  posterPath String?
  year       Int?
  rating     Float?
  watched    Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@index([userId])
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  query     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model MovieCache {
  id        String   @id // provider_movieId
  data      Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}
